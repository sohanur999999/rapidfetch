{
  "manifest_version": 3,
  "name": "RapidFetch - Free Download Manager",
  "short_name": "RapidFetch",
  "version": "1.0.0",
  "description": "Download files and videos faster with segmented, resumable transfers. Free for life, no trial and no subscription.",
  "minimum_chrome_version": "102",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RapidFetch",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "webRequest",
    "tabs",
    "notifications",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-capture": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Toggle automatic download capture"
    }
  }
}
