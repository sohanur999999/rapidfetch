<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RapidFetch.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so a single-file RapidFetch.exe can still hand the browser
         extension to the user and read its fixed identity. -->
    <EmbeddedResource Include="..\..\extension\**\*">
      <LogicalName>RapidFetch.Assets.extension/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\host\**\*">
      <LogicalName>RapidFetch.Assets.host/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Setup-mode assets. The installer writes these into the install folder. -->
    <EmbeddedResource Include="..\..\README.md"
                      LogicalName="RapidFetch.Assets.setup.README.md" />
    <EmbeddedResource Include="..\..\uninstall.ps1"
                      LogicalName="RapidFetch.Assets.setup.uninstall.ps1" />
    <EmbeddedResource Include="..\..\docs\**\*">
      <LogicalName>RapidFetch.Assets.setup.docs/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
