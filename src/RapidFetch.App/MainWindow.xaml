<Window x:Class="RapidFetch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RapidFetch.Core.Models;assembly=RapidFetch.Core"
        xmlns:local="clr-namespace:RapidFetch.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RapidFetch" Height="760" Width="1220" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" AllowDrop="True" SizeChanged="MainWindow_SizeChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="18"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <local:StatusToBrushConverter x:Key="StatusBrush" />
        <local:StatusToGlyphConverter x:Key="StatusGlyph" />
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <local:EmptyToVisibilityConverter x:Key="EmptyVis" />
        <local:InverseBoolConverter x:Key="Not" />

        <!-- flat menu buttons in the caption bar -->
        <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!-- icon-over-label toolbar buttons -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- sidebar tree -->
        <Style x:Key="SidebarTreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Focusable="False" ClickMode="Press"
                                                  Width="16" Height="16" Background="Transparent"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <Grid Width="10" Height="10">
                                            <Path x:Name="ChevronRight" Data="M 1 0 L 5 4 L 1 8"
                                                  Stroke="{DynamicResource Muted}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Path x:Name="ChevronDown" Data="M 0 1 L 4 5 L 8 1"
                                                  Stroke="{DynamicResource Muted}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Visibility="Collapsed" />
                                        </Grid>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="18,0,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ChevronRight" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ChevronDown" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource SidebarTreeItem}" />

        <!-- data grid -->
        <Style x:Key="ColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                <TextBlock x:Name="Arrow" Grid.Column="1" Text="&#xE70E;" Visibility="Collapsed"
                                           FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                           Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Arrow" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ColumnHeader}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="50" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SelectionCheck" TargetType="CheckBox">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="18" Height="18">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="{DynamicResource SurfaceAlt}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1" />
                            <Path x:Name="Tick" Data="M 3 7 L 7 11 L 13 4" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Path x:Name="Dash" Data="M 4 9 L 14 9" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckCell" TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="IconCell" TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="18">
        <Grid Background="{DynamicResource Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- liquid aurora behind the glass, kept low-saturation and diffused -->
            <Ellipse Grid.RowSpan="4" Width="820" Height="820" HorizontalAlignment="Right"
                     VerticalAlignment="Top" Margin="0,-480,-300,0" IsHitTestVisible="False"
                     Fill="{DynamicResource AuroraBlue}" />
            <Ellipse Grid.RowSpan="4" Width="760" Height="760" HorizontalAlignment="Left"
                     VerticalAlignment="Bottom" Margin="-320,0,0,-400" IsHitTestVisible="False"
                     Fill="{DynamicResource AuroraViolet}" />
            <Ellipse Grid.RowSpan="4" Width="1040" Height="620" HorizontalAlignment="Center"
                     VerticalAlignment="Bottom" Margin="0,0,0,-300" IsHitTestVisible="False"
                     Fill="{DynamicResource AuroraCyan}" />

            <!-- ===================== menu + search bar ===================== -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="Assets/logo.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="BrandTitle" Text="RapidFetch" FontSize="13.5" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border x:Name="VersionBadge" Style="{StaticResource Pill}" Margin="7,0,0,0" Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="1.0" FontSize="10" Foreground="{DynamicResource Muted}" />
                    </Border>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Border}" Margin="9,0,5,0" />
                    <Button Content="File" Style="{StaticResource MenuButton}" Click="MenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="New Download…" InputGestureText="Ctrl+N" Click="Add_Click" />
                                <MenuItem Header="Open Download Folder" Click="OpenFolder_Click" />
                                <Separator />
                                <MenuItem Header="Settings…" Click="Settings_Click" />
                                <Separator />
                                <MenuItem Header="Exit RapidFetch" Click="Exit_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Tasks" Style="{StaticResource MenuButton}" Click="MenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Resume" InputGestureText="Ctrl+R" Click="ResumeSelected_Click" />
                                <MenuItem Header="Pause" Click="PauseSelected_Click" />
                                <Separator />
                                <MenuItem Header="Start Queue" Click="StartQueue_Click" />
                                <MenuItem Header="Stop Queue" Click="StopQueue_Click" />
                                <MenuItem Header="Stop All" Click="StopAll_Click" />
                                <Separator />
                                <MenuItem Header="Delete Selected" InputGestureText="Del" Click="RemoveSelected_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Tools" Style="{StaticResource MenuButton}" Click="MenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Site Grabber…" Click="Grabber_Click" />
                                <MenuItem Header="Scheduler…" Click="Scheduler_Click" />
                                <Separator />
                                <MenuItem Header="Toggle Theme" Click="ToggleTheme_Click" />
                                <MenuItem Header="Settings…" Click="Settings_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Help" Style="{StaticResource MenuButton}" Click="MenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="About RapidFetch…" Click="About_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <Border x:Name="SearchBorder" Grid.ColumnSpan="3" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Width="300" Background="{DynamicResource SurfaceAlt}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="2" Panel.ZIndex="2"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource Muted}" Margin="9,0,7,0"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                     Padding="0,6,9,6" TextChanged="SearchBox_TextChanged" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Search downloads"
                                       Foreground="{DynamicResource Muted}" FontSize="12"
                                       Margin="1,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>

                        <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Margin="9,1,9,0"
                                   Fill="{DynamicResource Specular}" Opacity="0.5"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" AutomationProperties.Name="Minimize" Style="{StaticResource IconButton}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="Minimize" Width="46" Height="40" />
                    <Button x:Name="MaximizeButton" AutomationProperties.Name="Maximize" Style="{StaticResource IconButton}" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="Maximize" Width="46" Height="40" />
                    <Button x:Name="CloseButton" AutomationProperties.Name="Close" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="Close" Width="46" Height="40" />
                </StackPanel>

                <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                           Fill="{DynamicResource Hairline}" IsHitTestVisible="False" />
            </Grid>

            <!-- ===================== toolbar ===================== -->
            <Border Grid.Row="1" Background="Transparent"
                    BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="New Download" Click="Add_Click" ToolTip="Add a new download (Ctrl+N)">
                        <StackPanel>
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                            <TextBlock Text="New Download" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Accent}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="Resume" Click="ResumeSelected_Click" ToolTip="Resume selected (Ctrl+R)">
                        <StackPanel>
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Resume" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="Pause" Click="PauseSelected_Click" ToolTip="Pause selected">
                        <StackPanel>
                            <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Pause" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="Start Queue" Click="StartQueue_Click" ToolTip="Start queued downloads">
                        <StackPanel>
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Start Queue" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="Stop Queue" Click="StopQueue_Click" ToolTip="Stop the waiting queue">
                        <StackPanel>
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Stop Queue" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="30" Fill="{DynamicResource Hairline}" Margin="6,0" />
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="Queues" Click="Queues_Click" ToolTip="Show the main queue">
                        <StackPanel>
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Queues" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="Stop All" Click="StopAll_Click" ToolTip="Pause every active and queued download">
                        <StackPanel>
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Stop All" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="Delete" Click="RemoveSelected_Click" ToolTip="Remove selected from the list (Del)">
                        <StackPanel>
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Delete" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="30" Fill="{DynamicResource Hairline}" Margin="6,0" />
                    <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="Settings" Click="Settings_Click" ToolTip="Open settings">
                        <StackPanel>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Settings" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ===================== body ===================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- sidebar tree -->
                <Border Grid.Column="0" Margin="10,10,0,10" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="16">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TreeView x:Name="NavTree" Grid.Row="0" Background="Transparent" BorderThickness="0"
                                  SelectedItemChanged="NavTree_SelectedItemChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeViewItem x:Name="AllNode" Tag="all" IsExpanded="True">
                                <TreeViewItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="All downloads" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" x:Name="CountAll" Text="0" FontSize="10.5"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                    </Grid>
                                </TreeViewItem.Header>
                                <TreeViewItem.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="10.5"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </TreeViewItem.ItemTemplate>
                            </TreeViewItem>

                            <TreeViewItem Tag="done">
                                <TreeViewItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Finished" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" x:Name="CountDone" Text="0" FontSize="10.5"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                    </Grid>
                                </TreeViewItem.Header>
                            </TreeViewItem>

                            <TreeViewItem Tag="active">
                                <TreeViewItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Unfinished" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" x:Name="CountActive" Text="0" FontSize="10.5"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                    </Grid>
                                </TreeViewItem.Header>
                            </TreeViewItem>

                            <TreeViewItem x:Name="QueuesNode" Tag="queues" IsExpanded="True">
                                <TreeViewItem.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Queues" VerticalAlignment="Center" />
                                    </Grid>
                                </TreeViewItem.Header>
                                <TreeViewItem x:Name="MainNode" Tag="main">
                                    <TreeViewItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Main" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" x:Name="CountMain" Text="0" FontSize="10.5"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                        </Grid>
                                    </TreeViewItem.Header>
                                </TreeViewItem>
                            </TreeViewItem>
                        </TreeView>

                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="BridgeDot" Width="7" Height="7" Fill="{DynamicResource Muted}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="BridgeLabel" Text="Browser bridge offline" Margin="7,0,0,0"
                                                   FontSize="10.5" Foreground="{DynamicResource Muted}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Content="Toggle theme" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left" Padding="0" Margin="0,7,0,0"
                                            FontSize="10.5" Foreground="{DynamicResource Muted}"
                                            Click="ToggleTheme_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Rectangle Grid.RowSpan="2" Height="1" VerticalAlignment="Top" Margin="10,0,10,0"
                                   Fill="{DynamicResource Specular}" Opacity="0.5"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- download grid + details -->
                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource GlassEdge}"
                                BorderThickness="1" CornerRadius="16">
                            <Rectangle Height="1" VerticalAlignment="Top" Margin="18,0,18,0"
                                       Fill="{DynamicResource Specular}" Opacity="0.45"
                                       IsHitTestVisible="False" />
                        </Border>
                        <DataGrid x:Name="DownloadsGrid" Background="Transparent" BorderThickness="0"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" CanUserResizeColumns="False"
                                  CanUserResizeRows="False" CanUserSortColumns="True" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  SelectionMode="Extended" SelectionUnit="FullRow"
                                  RowHeaderWidth="0" RowHeight="NaN"
                                  ColumnHeaderStyle="{StaticResource ColumnHeader}"
                                  CellStyle="{StaticResource GridCell}"
                                  RowStyle="{StaticResource GridRow}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectionChanged="DownloadsGrid_SelectionChanged"
                                  MouseDoubleClick="DownloadsGrid_MouseDoubleClick"
                                  KeyDown="DownloadsGrid_KeyDown"
                                  SizeChanged="DownloadsGrid_SizeChanged"
                                  Sorting="DownloadsGrid_Sorting">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open file" Click="OpenFile_Click" />
                                    <MenuItem Header="Open containing folder" Click="OpenFolderItem_Click" />
                                    <MenuItem Header="Copy URL" Click="CopyUrl_Click" />
                                    <MenuItem Header="Refresh download address…" Click="RefreshAddress_Click" />
                                    <Separator />
                                    <MenuItem Header="Resume" Click="ResumeSelected_Click" />
                                    <MenuItem Header="Pause" Click="PauseSelected_Click" />
                                    <MenuItem Header="Remove from list" Click="RemoveSelected_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="CheckColumn" Width="32" CanUserSort="False"
                                                        HeaderStyle="{StaticResource CheckHeader}"
                                                        CellStyle="{StaticResource CheckCell}">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox x:Name="SelectAllCheck" AutomationProperties.Name="Select all downloads" IsThreeState="True"
                                                  Style="{StaticResource SelectionCheck}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Checked="SelectAll_Click" Unchecked="SelectAll_Click"
                                                  Indeterminate="SelectAll_Click"
                                                  ToolTip="Select all visible downloads" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource SelectionCheck}"
                                                      AutomationProperties.Name="Select download"
                                                      Checked="RowCheck_Changed" Unchecked="RowCheck_Changed"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="34" CanUserSort="False"
                                                        CellStyle="{StaticResource IconCell}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Width="28" Height="28" VerticalAlignment="Center">
                                                <Border CornerRadius="8"
                                                        Background="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                        Opacity="0.18" />
                                                <Border CornerRadius="8" BorderThickness="1"
                                                        BorderBrush="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                        Opacity="0.34" />
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusGlyph}}"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="NameColumn" Header="Name" Width="400" MinWidth="120"
                                                        SortMemberPath="DisplayName" CanUserSort="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="0,5,0,5">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Category}" FontSize="10.5"
                                                               Foreground="{DynamicResource Muted}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="10.5"
                                                               Foreground="{DynamicResource Muted}" Margin="8,0,0,0" />
                                                </Grid>
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1"
                                                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolVis}}"
                                                             Height="2" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn x:Name="SizeColumn" Header="Size" Width="136" SortMemberPath="TotalBytes"
                                                    CanUserSort="True" Binding="{Binding SizeText}"
                                                    ElementStyle="{StaticResource CellText}" />

                                <DataGridTemplateColumn x:Name="StatusColumn" Header="Status" Width="108" SortMemberPath="StatusRank"
                                                        CanUserSort="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11.5"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn x:Name="SpeedColumn" Header="Speed" Width="78" SortMemberPath="Speed"
                                                    CanUserSort="True" Binding="{Binding SpeedText}"
                                                    ElementStyle="{StaticResource CellText}" />

                                <DataGridTextColumn x:Name="EtaColumn" Header="Time Left" Width="78" SortMemberPath="EtaSeconds"
                                                    CanUserSort="True" Binding="{Binding EtaText}"
                                                    ElementStyle="{StaticResource CellText}" />

                                <DataGridTextColumn x:Name="DateColumn" Header="Date Added" Width="112"
                                                    SortMemberPath="Added" CanUserSort="True"
                                                    Binding="{Binding AddedText}"
                                                    ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Panel.ZIndex="2"
                                    Visibility="{Binding ElementName=DownloadsGrid, Path=Items.Count, Converter={StaticResource EmptyVis}}">
                            <Border Width="64" Height="64" CornerRadius="19" Background="{DynamicResource SurfaceAlt}"
                                    BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="25"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No downloads here" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="Add a link or let the browser extension send one over."
                                       Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <Button Style="{StaticResource PrimaryButton}" Content="New Download"
                                    HorizontalAlignment="Center" Margin="0,16,0,0" Click="Add_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- details: appears when a row is selected -->
                    <Border x:Name="DetailsPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource GlassEdge}"
                            BorderThickness="1" CornerRadius="16" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="DetailNameColumn" Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailName" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailCategory" FontSize="10.5"
                                               Foreground="{DynamicResource Muted}" />
                                    <TextBlock Grid.Column="1" Text=" · " FontSize="10.5"
                                               Foreground="{DynamicResource Muted}" />
                                    <TextBlock Grid.Column="2" x:Name="DetailStatus" FontSize="10.5"
                                               Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <ProgressBar x:Name="DetailProgress" Value="0" Maximum="1" Height="4" Margin="0,7,0,0" />
                                <Grid Margin="0,5,0,0">
                                    <TextBlock x:Name="DetailSize" FontSize="10.5" Foreground="{DynamicResource Muted}" />
                                    <TextBlock x:Name="DetailPercent" FontSize="10.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailSpeed" FontSize="10.5" Foreground="{DynamicResource Muted}" />
                                    <TextBlock x:Name="DetailEta" FontSize="10.5" Foreground="{DynamicResource Muted}"
                                               Margin="10,0,0,0" />
                                    <TextBlock Grid.Column="2" x:Name="DetailConnections" FontSize="10.5"
                                               Foreground="{DynamicResource Muted}" Margin="10,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="SOURCE" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                <TextBlock x:Name="DetailUrl" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                                <TextBlock Text="SAVED TO" Style="{StaticResource Caption}" FontWeight="SemiBold"
                                           Margin="0,7,0,0" />
                                <TextBlock x:Name="DetailPath" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Open file" AutomationProperties.Name="Open file" Style="{StaticResource PrimaryButton}" Padding="12,6"
                                        Click="OpenFile_Click" />
                                <Button Content="Folder" AutomationProperties.Name="Open folder" Style="{StaticResource ButtonBase}" Padding="12,6"
                                        Margin="6,0,0,0" Click="OpenFolderItem_Click" />
                                <Button Style="{StaticResource GhostButton}" AutomationProperties.Name="Remove from list" Width="32" Height="32" Padding="0"
                                        Margin="4,0,0,0" ToolTip="Remove from list" Click="RemoveSelected_Click">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                </Button>
                            </StackPanel>

                            <Button Grid.Column="3" AutomationProperties.Name="Close details" Style="{StaticResource IconButton}" Content="&#xE711;"
                                    Width="28" Height="28" VerticalAlignment="Top" ToolTip="Close details"
                                    Click="DetailsClose_Click" />

                            <Rectangle Grid.ColumnSpan="4" Height="1" VerticalAlignment="Top" Margin="2,0,2,0"
                                       Fill="{DynamicResource Specular}" Opacity="0.45"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===================== status bar ===================== -->
            <Border Grid.Row="3" Background="Transparent" BorderBrush="{DynamicResource Hairline}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusView" Text="All downloads" FontSize="10.5"
                                   Foreground="{DynamicResource Muted}" />
                        <TextBlock Text="·" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="7,0" />
                        <TextBlock x:Name="StatusCount" Text="0 items" FontSize="10.5"
                                   Foreground="{DynamicResource Muted}" />
                        <TextBlock Text="·" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="7,0" />
                        <TextBlock x:Name="StatusActive" Text="0 active" FontSize="10.5"
                                   Foreground="{DynamicResource Muted}" />
                        <TextBlock Text="·" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="7,0" />
                        <TextBlock x:Name="StatusSpeed" Text="0 B/s" FontSize="10.5"
                                   Foreground="{DynamicResource Muted}" />
                        <TextBlock x:Name="StatusSession" Text="session 0 B" FontSize="10.5"
                                   Foreground="{DynamicResource Muted}" Margin="7,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="QueueStatus" Text="Queue running" FontSize="10.5"
                                   Foreground="{DynamicResource Success}" />
                        <TextBlock Text="·" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="7,0" />
                        <TextBlock x:Name="StatusPort" Text="bridge :55123" FontSize="10.5"
                                   Foreground="{DynamicResource Muted}" />
                        <TextBlock Text="·" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="7,0" />
                        <TextBlock x:Name="FreeLabel" Text="Free · unlimited connections" FontSize="10.5"
                                   Foreground="{DynamicResource Success}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
