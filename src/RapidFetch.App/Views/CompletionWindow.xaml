<Window x:Class="RapidFetch.App.Views.CompletionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RapidFetch download complete" Width="320" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown" Closing="Window_Closing">

    <Window.Resources>
        <!-- Borderless glass action. The hierarchy comes from the fill, not a stroke. -->
        <Style x:Key="GlassAction" TargetType="Button">
            <Setter Property="Foreground" Value="#EDEFF4" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPrimary" TargetType="Button" BasedOn="{StaticResource GlassAction}">
            <Setter Property="Background" Value="#34FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <!-- No BorderBrush and no outer margin: the card is pure translucent
         material, so the window bounds are the visible panel bounds. -->
    <Border Margin="0" CornerRadius="18" BorderThickness="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#AC1A1A1B" Offset="0" />
                <GradientStop Color="#840B0B0C" Offset="0.5" />
                <GradientStop Color="#9C141415" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <!-- Soft specular sheen. It is a highlight, not an outline. -->
            <Border CornerRadius="18" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#30FFFFFF" Offset="0" />
                        <GradientStop Color="#0AFFFFFF" Offset="0.2" />
                        <GradientStop Color="#00FFFFFF" Offset="0.62" />
                        <GradientStop Color="#10FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="14,12,14,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===================== heading ===================== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="28" Height="28" CornerRadius="14" Background="#1CFFFFFF">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#F3F4F7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Download complete" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="#F7F8FA" />
                        <TextBlock Text="Your file is ready." FontSize="10.5" Foreground="#D2D5DC"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ===================== file ===================== -->
                <Border x:Name="FileCard" Grid.Row="1" Margin="0,9,0,0" Padding="8,7"
                        CornerRadius="10" Background="#14FFFFFF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13.5"
                                   Foreground="#B7BAC2"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="FileNameText" Text="file.mp4" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="#F2F3F6"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FileMetaText" Text="Video · 0 B" FontSize="10"
                                       Foreground="#CDD0D8" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===================== actions ===================== -->
                <Grid Grid.Row="2" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="OpenButton" Style="{StaticResource GlassPrimary}"
                            Content="Open" AutomationProperties.Name="Open completed file"
                            Click="Open_Click" />
                    <Button x:Name="OpenFolderButton" Grid.Column="1" Style="{StaticResource GlassAction}"
                            Content="Open folder" AutomationProperties.Name="Open completed folder"
                            Margin="5,0,0,0" Click="OpenFolder_Click" />
                    <Button Grid.Column="2" Style="{StaticResource GlassAction}"
                            Content="Close" AutomationProperties.Name="Close completion panel"
                            Margin="5,0,0,0" Click="Close_Click" />
                </Grid>

                <TextBlock Grid.Row="3" Text="Closes in 30s · Hover to keep open"
                           FontSize="9.5" Foreground="#C4C7CF" HorizontalAlignment="Center"
                           Margin="0,6,0,0" Opacity="0.85" />
            </Grid>
        </Grid>
    </Border>
</Window>
