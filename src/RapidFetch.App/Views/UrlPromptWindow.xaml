<Window x:Class="RapidFetch.App.Views.UrlPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Refresh download address" Height="286" Width="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource Bg}" ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="4" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource Surface}" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="Refresh download address" FontWeight="SemiBold" Margin="18,0,0,0"
                           VerticalAlignment="Center" />
                <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" Width="44" Height="44"
                        HorizontalAlignment="Right" Click="Cancel_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,18">
                <TextBlock Text="DOWNLOAD" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                <TextBlock x:Name="FileNameText" FontWeight="SemiBold" FontSize="14" Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Text="NEW ADDRESS" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,18,0,0" />
                <TextBox x:Name="UrlBox" Margin="0,6,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                <TextBlock Text="Use this when a signed or expiring link has stopped working. The transfer restarts from the beginning."
                           Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" FontSize="12"
                           Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
                    <Button Content="Update and resume" Style="{StaticResource PrimaryButton}"
                            Click="Update_Click" MinWidth="140" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
