<Window x:Class="RapidFetch.App.Views.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RapidFetch.App"
        Title="RapidFetch transfers" Width="430" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown" Closing="Window_Closing">

    <Window.Resources>
        <local:StatusToBrushConverter x:Key="StatusBrush" />
        <local:StatusToGlyphConverter x:Key="StatusGlyph" />
        <local:StatusToVisibilityConverter x:Key="StatusVis" />
    </Window.Resources>

    <Border Margin="14" CornerRadius="16" Background="{DynamicResource Elevated}"
            BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity="0.42" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===================== title ===================== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="DragArea" Background="Transparent" Padding="14,0,0,0"
                        MouseLeftButtonDown="Header_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/logo.png" Width="20" Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Transfers" FontWeight="SemiBold" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                        <Border Style="{StaticResource Pill}" Margin="9,0,0,0" Padding="7,2"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="{DynamicResource Accent}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="StatePillText" Text="Live" FontSize="10" Margin="5,0,0,0"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;"
                            AutomationProperties.Name="Open RapidFetch"
                            ToolTip="Open RapidFetch" Click="Open_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;"
                            AutomationProperties.Name="Hide transfer panel"
                            ToolTip="Hide this panel (Esc)" Click="Hide_Click" />
                </StackPanel>
            </Grid>

            <!-- ===================== speed ===================== -->
            <Grid Grid.Row="1" Margin="16,2,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="SpeedLabel" Text="0 B/s" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" />
                    <TextBlock x:Name="SummaryLabel" Text="No active transfers"
                               Style="{StaticResource Caption}" Margin="1,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <TextBlock x:Name="PeakLabel" Text="peak —" Style="{StaticResource Caption}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="last 30 s" Style="{StaticResource Caption}" Opacity="0.7"
                               HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- ===================== graph ===================== -->
            <Border Grid.Row="2" Margin="16,0,16,12" Height="64" Background="{DynamicResource Well}"
                    BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="10"
                    ClipToBounds="True">
                <Canvas x:Name="SpeedCanvas" ClipToBounds="True" Margin="1" />
            </Border>

            <!-- ===================== rows ===================== -->
            <Grid Grid.Row="3" MinHeight="64">
                <ScrollViewer x:Name="RowsScroll" MaxHeight="232" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                    <ItemsControl x:Name="RowsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="60" Margin="7,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="26" Height="26" CornerRadius="8"
                                            Background="{DynamicResource SurfaceAlt}"
                                            VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding Status, Converter={StaticResource StatusGlyph}}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3"
                                                     IsIndeterminate="{Binding IsIndeterminate}" Margin="0,5,0,0" />
                                        <Grid Margin="0,4,0,0">
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource Accent}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PercentText}" FontSize="10.5"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Muted}" />
                                        <Grid Height="24" Margin="0,3,0,0" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                                        FontSize="10" Content="&#xE769;" ToolTip="Pause"
                                                        AutomationProperties.Name="Pause transfer"
                                                        Visibility="{Binding Status, Converter={StaticResource StatusVis}, ConverterParameter=Downloading}"
                                                        Click="Pause_Click" />
                                                <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                                        FontSize="10" Content="&#xE768;" ToolTip="Resume"
                                                        AutomationProperties.Name="Resume transfer"
                                                        Visibility="{Binding Status, Converter={StaticResource StatusVis}, ConverterParameter=Paused|Failed|Canceled}"
                                                        Click="Resume_Click" />
                                                <Button Style="{StaticResource IconButton}" Width="22" Height="22"
                                                        FontSize="10" Content="&#xE711;" ToolTip="Cancel transfer"
                                                        AutomationProperties.Name="Cancel transfer"
                                                        Foreground="{DynamicResource Danger}" Margin="2,0,0,0"
                                                        Visibility="{Binding Status, Converter={StaticResource StatusVis}, ConverterParameter=Downloading|Probing|Queued|Paused|Failed}"
                                                        Click="Cancel_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="20,10,20,18">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitle" Text="No active transfers" FontWeight="SemiBold"
                               Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Downloads you start from your browser will appear here."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ===================== footer ===================== -->
            <Grid Grid.Row="4" Margin="16,4,16,10">
                <TextBlock x:Name="FooterHint" Text="Drag to move · Esc to hide"
                           Style="{StaticResource Caption}" VerticalAlignment="Center" Opacity="0.8" />

                <StackPanel x:Name="CompleteActions" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button Content="Open" Style="{StaticResource PrimaryButton}" FontSize="11"
                            Padding="11,3" AutomationProperties.Name="Open file" Click="OpenFile_Click" />
                    <Button Content="Open folder" Style="{StaticResource GhostButton}" FontSize="11"
                            Padding="8,3" Margin="4,0,0,0" AutomationProperties.Name="Open folder"
                            Click="OpenFolder_Click" />
                    <Button Content="Close" Style="{StaticResource GhostButton}" FontSize="11"
                            Padding="8,3" Margin="4,0,0,0" AutomationProperties.Name="Close transfer panel"
                            Click="ClosePanel_Click" />
                </StackPanel>

                <Button x:Name="OpenManagerButton" Content="Open manager" Style="{StaticResource GhostButton}"
                        FontSize="11" AutomationProperties.Name="Open manager"
                        Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Open_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
