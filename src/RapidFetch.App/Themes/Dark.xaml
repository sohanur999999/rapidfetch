<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#05070C</Color>
    <Color x:Key="SurfaceColor">#A0161C28</Color>
    <Color x:Key="SurfaceAltColor">#1FFFFFFF</Color>
    <Color x:Key="ElevatedColor">#E8181F2D</Color>
    <Color x:Key="BorderColor">#26FFFFFF</Color>
    <Color x:Key="TextColor">#F7F9FF</Color>
    <Color x:Key="MutedColor">#A9B3C9</Color>
    <Color x:Key="AccentColor">#0A84FF</Color>
    <Color x:Key="AccentHoverColor">#5AC8FA</Color>
    <Color x:Key="DangerColor">#FF453A</Color>
    <Color x:Key="SuccessColor">#30D158</Color>
    <Color x:Key="WarningColor">#FFD60A</Color>

    <!-- deep neutral base: the glow underneath stays quiet, like iOS dark glass -->
    <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#05060A" Offset="0" />
        <GradientStop Color="#080D17" Offset="0.42" />
        <GradientStop Color="#070910" Offset="0.68" />
        <GradientStop Color="#04050A" Offset="1" />
    </LinearGradientBrush>

    <!-- smoked glass: translucent enough to feel like a lens, not a wall -->
    <LinearGradientBrush x:Key="Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7A202A3C" Offset="0" />
        <GradientStop Color="#66141B28" Offset="0.5" />
        <GradientStop Color="#701A2232" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SurfaceAlt" Color="{DynamicResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="Elevated" Color="{DynamicResource ElevatedColor}" />
    <SolidColorBrush x:Key="Well" Color="#33000000" />
    <SolidColorBrush x:Key="Border" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="Hairline" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Specular" Color="#66FFFFFF" />
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6BFFFFFF" Offset="0" />
        <GradientStop Color="#24FFFFFF" Offset="0.35" />
        <GradientStop Color="#14FFFFFF" Offset="0.62" />
        <GradientStop Color="#33FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassHighlight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#47FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="0.28" />
        <GradientStop Color="#00FFFFFF" Offset="0.55" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Text" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{DynamicResource MutedColor}" />
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="Danger" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="Success" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="Warning" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{DynamicResource AccentColor}" Opacity="0.16" />

    <!-- almost monochrome cool light, heavily diffused -->
    <RadialGradientBrush x:Key="AuroraBlue" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#4D6E9BE8" Offset="0" />
        <GradientStop Color="#286E9BE8" Offset="0.46" />
        <GradientStop Color="#006E9BE8" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraViolet" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#478A8FB8" Offset="0" />
        <GradientStop Color="#228A8FB8" Offset="0.5" />
        <GradientStop Color="#008A8FB8" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraCyan" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#3872A8BC" Offset="0" />
        <GradientStop Color="#1A72A8BC" Offset="0.52" />
        <GradientStop Color="#0072A8BC" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
