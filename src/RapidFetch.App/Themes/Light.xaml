<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#F4F6FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#EDF1F7</Color>
    <Color x:Key="ElevatedColor">#E4EAF2</Color>
    <Color x:Key="BorderColor">#D7DEE9</Color>
    <Color x:Key="TextColor">#111827</Color>
    <Color x:Key="MutedColor">#667085</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="WarningColor">#D97706</Color>

    <SolidColorBrush x:Key="Bg" Color="{DynamicResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="{DynamicResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="Elevated" Color="{DynamicResource ElevatedColor}" />
    <SolidColorBrush x:Key="Well" Color="#0F000000" />
    <SolidColorBrush x:Key="Border" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="Hairline" Color="#14000000" />
    <SolidColorBrush x:Key="Specular" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="GlassEdge" Color="#33000000" />
    <LinearGradientBrush x:Key="GlassHighlight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#99FFFFFF" Offset="0" />
        <GradientStop Color="#33FFFFFF" Offset="0.35" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Text" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{DynamicResource MutedColor}" />
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="Danger" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="Success" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="Warning" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{DynamicResource AccentColor}" Opacity="0.10" />

    <RadialGradientBrush x:Key="AuroraBlue" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#332563EB" Offset="0" />
        <GradientStop Color="#123B82F6" Offset="0.5" />
        <GradientStop Color="#003B82F6" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraViolet" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#298B5CF6" Offset="0" />
        <GradientStop Color="#0F8B5CF6" Offset="0.52" />
        <GradientStop Color="#008B5CF6" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraCyan" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#2206B6D4" Offset="0" />
        <GradientStop Color="#0A06B6D4" Offset="0.55" />
        <GradientStop Color="#0006B6D4" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
